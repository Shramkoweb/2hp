{
  "name": "2hp",
  "private": true,
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache --log-level warn .",
    "lint": "eslint --cache --max-warnings 0 .",
    "lint:css": "stylelint --cache --allow-empty-input --max-warnings 0 \"src/**/*.css\"",
    "typecheck": "astro check",
    "knip": "knip --no-progress",
    "check": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm typecheck && pnpm knip && pnpm build"
  },
  "dependencies": {
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "knip": "^6.42.0",
    "lefthook": "2.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
