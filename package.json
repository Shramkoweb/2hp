{
  "name": "2hp",
  "private": true,
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache --log-level warn .",
    "lint": "eslint --max-warnings 0 .",
    "lint:css": "stylelint --cache --max-warnings 0 \"src/**/*.css\"",
    "lint:tokens": "! grep -rInE --exclude=theme.css \"#[0-9a-fA-F]{3,8}\\b|\\b(rgba?|hsla?|hwb|lab|lch|oklab|oklch|color)\\(|var\\(--(white|neutral-[0-9]+|blue-[0-9]+)\\)\" src",
    "typecheck": "astro check",
    "knip": "knip --no-progress",
    "test:e2e": "docker run --rm --platform linux/amd64 --init --ipc=host --network none -v \"$PWD\":/work:ro -v \"$PWD/.playwright\":/work/.playwright -w /work mcr.microsoft.com/playwright:v1.64.1-noble node node_modules/@playwright/test/cli.js test",
    "test:e2e:write": "docker run --rm --platform linux/amd64 --init --ipc=host --network none -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.64.1-noble node node_modules/@playwright/test/cli.js test",
    "check": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm lint:tokens && pnpm typecheck && pnpm knip && pnpm build"
  },
  "dependencies": {
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "knip": "^6.42.0",
    "lefthook": "2.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
