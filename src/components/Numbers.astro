---
import { getCollection } from "astro:content";
import { count } from "../data/count";
import { formatDate, formatDay } from "../lib/format";
import ProjectRow from "./ProjectRow.astro";
import Section from "./Section.astro";

const projects = (await getCollection("projects")).toSorted(
  (a, b) => a.data.order - b.data.order,
);
const intro = `Users across all stores, counted ${formatDate(count.counted)}. Next count: ${formatDay(count.next)}.`;
---

<Section id="projects" title="The numbers" intro={intro}>
  {projects.map((project) => (
    <ProjectRow project={project} />
  ))}
</Section>
