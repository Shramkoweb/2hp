---
import type { CollectionEntry } from "astro:content";
import { formatDate, formatDay } from "../lib/format";

interface Props {
  name: string;
  installs: CollectionEntry<"projects">["data"]["installs"];
  class?: string;
}

const { name, installs, class: className } = Astro.props;
const { weekly } = installs;

const num = (value: number) => String(Number(value.toFixed(1)));
const week = (offset: number) => {
  const date = new Date(installs.from);
  date.setUTCDate(date.getUTCDate() + offset);
  return date;
};

const best = Math.max(...weekly);
const bestIndex = weekly.indexOf(best);
const last = weekly.at(-1) ?? 0;
const total = weekly.reduce((sum, value) => sum + value, 0);
const start = formatDay(week(0));
const end = formatDate(week(weekly.length * 7 - 1));

const bars = weekly.map((value, i) => {
  const height = Number(((value * 92) / best).toFixed(1));
  return {
    x: 46.6 + i * 13.6,
    y: Number((118 - height).toFixed(1)),
    height,
    now: i === weekly.length - 1,
  };
});
const lastBar = bars[bars.length - 1] ?? { x: 0, y: 0 };
const bestX = bars[bestIndex]?.x ?? 0;

const label = `${name}: ${installs.store} installs per week, ${start} to ${end}, ${String(total)} in total. Best week ${String(best)} installs, week of ${formatDay(week(bestIndex * 7))}. Last week ${String(last)}.`;
const caption = `${installs.store} installs per week, last ${String(weekly.length)} weeks`;
---

<figure class:list={["chart m-0", className]} data-chart>
  <svg
    class="block h-auto w-full overflow-visible"
    viewBox="0 0 400 168"
    role="img"
    aria-label={label}
  >
    {bars.map((bar, i) => (
      <rect
        class:list={[
          "bar origin-bottom transform-fill",
          bar.now ? "fill-foreground" : "fill-chart",
        ]}
        style={`--b:${String(i)}`}
        x={num(bar.x)}
        y={num(bar.y)}
        width="8.4"
        height={num(bar.height)}
        rx="1.5"
      />
    ))}
    <path
      class="stroke-foreground"
      d="M42 118H386"
      fill="none"
      stroke-width="1.5"
    ></path>
    <text
      class="fill-muted-foreground text-meta font-medium tabular-nums"
      x="34"
      y="123"
      text-anchor="end"
      set:text="0"
    />
    <text
      class="ink fill-foreground text-meta font-bold tabular-nums"
      x={num(lastBar.x + 4.2)}
      y={num(lastBar.y - 8)}
      text-anchor="middle"
      set:text={String(last)}
    />
    <text
      class="fill-muted-foreground text-meta font-medium tabular-nums"
      x="44"
      y="162"
      set:text={start}
    />
    <text
      class="fill-muted-foreground text-meta font-medium tabular-nums"
      x="384"
      y="162"
      text-anchor="end"
      set:text={end}
    />
    <g class="ev">
      <path
        class="stroke-annotation"
        d={`M${num(bestX - 5.8)} 28c0-7 5-10 10-10s10 4 9 10-6 9-10 9-10-4-9-10 3-8 6-9`}
        fill="none"
        stroke-width="2"
        stroke-linecap="round"
      ></path>
      <text
        class="fill-annotation font-hand text-small font-medium"
        x={num(bestX + 20.2)}
        y="20"
        set:text={`best week: ${String(best)} installs`}
      />
    </g>
  </svg>
  <figcaption class="mt-0.5 pl-chart-inset text-meta text-muted-foreground">
    {caption}
  </figcaption>
</figure>
