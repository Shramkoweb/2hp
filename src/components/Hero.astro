---
import { getCollection } from "astro:content";
import ShelfItem from "./ShelfItem.astro";

const projects = (await getCollection("projects")).toSorted(
  (a, b) => a.data.order - b.data.order,
);

const total = projects.length;
const shown = total > 4 ? projects.slice(0, 3) : projects;
const more = total > 4 ? total - 3 : 0;
const next = total < 2 ? total + 1 : 0;

const words = ["TwoHour", "Project"].map((word, w, all) => {
  const start = all.slice(0, w).join("").length;
  return Array.from(word).map((ch, i) => ({ ch, i: start + i }));
});
---

<section class="hero" aria-labelledby="name">
  <div class="wrap">
    <h1 class="name" id="name" aria-label="TwoHour Project">
      {words.map((letters) => (
        <span class="w" aria-hidden="true">
          {letters.map(({ ch, i }) => (
            <span class="l" data-ch={ch} data-letter style={`--i:${String(i)}`}>
              {ch}
            </span>
          ))}
        </span>
      ))}
    </h1>
    <p class="aside">
      <svg viewBox="0 0 90 46" aria-hidden="true">
        <path d="M86 8 C 64 4, 30 10, 10 34 M4 22 L9 36 L22 32"></path>
      </svg>
      2 extensions so far, 2&nbsp;mobile apps next
    </p>
    <div class="copy">
      <p class="strap">Small apps, built in public.</p>
      <p class="lede">
        I'm Serhii Shramko, an indie developer in Boston. For each app I make, I
        post the real numbers: users, weekly installs, ratings.
      </p>
      <a class="cta" href="https://x.com/twohourproject">
        Follow along on X
      </a>
      <p class="also">
        <a href="#subscribe">or get the newsletter</a>
      </p>
    </div>
    <ul class="shelf" aria-label="My apps">
      {shown.map((project) => (
        <ShelfItem project={project} />
      ))}
      {more > 0 && (
        <li>
          <a class="plate more" href="#projects" data-plate>
            <span>{`+${String(more)}`}</span>
          </a>
          <h3>{`${String(more)} more`}</h3>
          <a class="all" href="#projects">{`All ${String(total)} apps`}</a>
        </li>
      )}
      {next > 0 && (
        <li>
          <div class="plate next" data-plate>
            <span>{`#${String(next)}`}</span>
          </div>
          <h3>{next === 1 ? "First app" : "Next app"}</h3>
          <p class="soon">
            {next === 1
              ? "ships soon. Follow along to see it launch."
              : "in the works"}
          </p>
        </li>
      )}
    </ul>
  </div>
</section>
