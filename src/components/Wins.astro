---
import { getCollection } from "astro:content";
import { formatMonth } from "../lib/format";

const labels = { win: "Win: ", flop: "Flop: " };

const entries = (await getCollection("log")).toSorted((a, b) =>
  b.data.month.localeCompare(a.data.month),
);
---

<section class="sec" id="wins" aria-labelledby="wins-h">
  <div class="wrap">
    <h2 id="wins-h">Wins &amp; flops</h2>
    <ol class="log">
      {entries.length === 0 ? (
        <li class="empty">
          No verdicts yet. The first marks go here with the November numbers.
        </li>
      ) : (
        entries.map(({ data: entry }) => (
          <li>
            <time datetime={entry.month}>
              {formatMonth(new Date(entry.month))}
            </time>
            <svg class="mk" aria-hidden="true">
              <use href={`#mk-${entry.kind}`}></use>
            </svg>
            <p>
              <span class="sr-only">{labels[entry.kind]}</span>
              <b>{entry.lead}</b> {entry.text}
            </p>
            {entry.lesson && <p class="lesson">{entry.lesson}</p>}
          </li>
        ))
      )}
    </ol>
  </div>
</section>
