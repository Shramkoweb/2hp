---
import type { CollectionEntry } from "astro:content";
import { formatNumber } from "../lib/format";

interface Props {
  project: CollectionEntry<"projects">;
}

const { id, data } = Astro.props.project;
---

<li>
  <a class="plate" href={`#p-${id}`} aria-label={data.name} data-plate>
    <img
      class="logo"
      src={data.logo.src}
      alt=""
      width={data.logo.width}
      height={data.logo.height}
    />
  </a>
  <h3>{data.name}</h3>
  {/* prettier-ignore */}
  <p class="num">{formatNumber(data.users)}<small> users</small></p>
</li>
