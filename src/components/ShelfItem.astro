---
import type { CollectionEntry } from "astro:content";
import { formatNumber } from "../lib/format";
import Plate from "./Plate.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { id, data } = Astro.props.project;
---

<li class="flex flex-col items-start">
  <Plate href={`#p-${id}`} label={data.name} bounce>
    <img
      class="block aspect-square h-auto w-31/50 object-contain"
      src={data.logo.src}
      alt=""
      width={data.logo.width}
      height={data.logo.height}
    />
  </Plate>
  <h3 class="m-0 mt-4.5 text-body/title font-bold tracking-tight md:mt-5.5">
    {data.name}
  </h3>
  {/* prettier-ignore */}
  <p class="m-0 mt-0.5 text-figure whitespace-nowrap tabular-nums">{formatNumber(data.users)}<small class="text-note font-demibold tracking-tight"> users</small></p>
</li>
