---
import Section from "./Section.astro";
---

<Section id="follow" title="Follow along" last>
  <div class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-2">
    <a
      class="group grid grid-cols-fill-auto content-center items-center gap-x-3 gap-y-1 rounded-btn border-3 border-foreground bg-primary px-5 py-5.5 text-primary-foreground no-underline shadow-hard-6 transition-lift duration-120 ease-out hover:-translate-0.5 hover:shadow-hard-8 active:translate-1.25 active:shadow-hard-1 md:gap-x-6 md:gap-y-1.5 md:px-8 md:py-7 forced-colors:border-canvas-text"
      href="https://x.com/twohourproject"
    >
      <span class="col-start-1 row-start-1 text-handle whitespace-nowrap md:text-stat md:whitespace-normal">
        @twohourproject on X
      </span>
      <span class="col-start-1 row-start-2 font-hand text-note/note font-medium">
        progress and numbers
      </span>
      <svg
        class="col-start-2 row-span-2 row-start-1 size-6 transition-transform duration-200 ease-spring group-hover:translate-x-1.5 md:size-8"
        aria-hidden="true"
      >
        <use href="#i-arrow"></use>
      </svg>
    </a>
    <form
      class="grid content-center gap-3 rounded-btn border-3 border-foreground bg-card px-5 py-5.5 shadow-hard-6 md:px-8 md:py-7 forced-colors:border-canvas-text"
      id="subscribe"
      action="#"
      method="post"
      data-mail
    >
      <label class="text-stat" for="email">
        Get the newsletter
      </label>
      <div class="flex flex-col gap-2.5 md:flex-row">
        <input
          class="h-13 w-full min-w-0 flex-none rounded-field border-field border-foreground bg-background px-4 py-0 font-text text-note font-normal text-foreground placeholder:text-placeholder focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-ring md:w-0 md:shrink md:grow md:basis-0 forced-colors:border-canvas-text"
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="you@example.com"
          required
        />
        <button
          class="h-13 cursor-pointer rounded-field border-field border-foreground bg-foreground px-5 py-0 font-text text-note font-bold text-inverse-foreground transition-background duration-150 ease-out hover:bg-foreground-hover forced-colors:border-canvas-text"
          type="submit"
        >
          Subscribe
        </button>
      </div>
      <p
        class="m-0 font-hand text-meta/hint font-medium text-annotation"
        id="mail-status"
        role="status"
        data-mail-status
      >
        Separate from the posts on this site.
      </p>
    </form>
  </div>
  <ul
    class="m-0 mt-10 flex list-none flex-col flex-wrap gap-4.5 p-0 md:flex-row md:gap-x-14 md:gap-y-5"
    aria-label="Other channels"
  >
    <li class="flex flex-col items-start gap-0.5">
      <a
        class="text-h4 font-heavy tracking-snug decoration-2 underline-offset-4"
        href="https://t.me/twohourproject"
      >
        Telegram
      </a>
      <span class="text-meta text-muted-foreground">in Ukrainian</span>
    </li>
    <li class="flex flex-col items-start gap-0.5">
      <a
        class="text-h4 font-heavy tracking-snug decoration-2 underline-offset-4"
        href="https://github.com/shramkoweb"
      >
        GitHub
      </a>
      <span class="text-meta text-muted-foreground">@shramkoweb</span>
    </li>
  </ul>
</Section>
