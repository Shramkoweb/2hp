<section class="sec last" id="follow" aria-labelledby="follow-h">
  <div class="wrap">
    <h2 id="follow-h">Follow along</h2>
    <div class="ways">
      <a class="follow-x" href="https://x.com/twohourproject">
        <span class="t">@twohourproject on X</span>
        <span class="h">progress and numbers</span>
        <svg class="arr" aria-hidden="true">
          <use href="#i-arrow"></use>
        </svg>
      </a>
      <form class="mail" id="subscribe" action="#" method="post" data-mail>
        <label for="email">Get the newsletter</label>
        <div class="row">
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
            required
          />
          <button type="submit">Subscribe</button>
        </div>
        <p class="hint" id="mail-status" role="status" data-mail-status>
          Separate from the posts on this site.
        </p>
      </form>
    </div>
    <ul class="others" aria-label="Other channels">
      <li>
        <a href="https://t.me/twohourproject">Telegram</a>
        <span>in Ukrainian</span>
      </li>
      <li>
        <a href="https://github.com/shramkoweb">GitHub</a>
        <span>@shramkoweb</span>
      </li>
    </ul>
  </div>
</section>
