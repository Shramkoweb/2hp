---
import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).toSorted(
  (a, b) => a.data.order - b.data.order,
);
---

<section class="sec" id="writing" aria-labelledby="writing-h">
  <div class="wrap">
    <h2 id="writing-h">Writing</h2>
    <p class="intro">
      I'm writing these now. The first one goes up in November, with the new
      numbers.
    </p>
    <ol class="posts">
      {posts.map(({ data }) => (
        <li>
          {data.draft && <span class="draft">draft</span>}
          <h3>{data.title}</h3>
        </li>
      ))}
    </ol>
  </div>
</section>
