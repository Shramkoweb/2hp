---
import { getCollection } from "astro:content";
import Section from "./Section.astro";

const posts = (await getCollection("posts")).toSorted(
  (a, b) => a.data.order - b.data.order,
);
---

<Section
  id="writing"
  title="Writing"
  intro="I'm writing these now. The first one goes up in November, with the new numbers."
>
  <ol class="m-0 mb-6 list-none border-t-2 border-foreground p-0">
    {posts.map(({ data }) => (
      <li class="grid grid-cols-1 items-baseline gap-1 border-b-2 border-foreground py-4.5 md:grid-cols-post md:gap-x-6 md:gap-y-0">
        {data.draft && (
          <span class="font-hand text-meta/note font-medium text-annotation">
            draft
          </span>
        )}
        <h3 class="m-0 text-h4/title font-bold tracking-snug">{data.title}</h3>
      </li>
    ))}
  </ol>
</Section>
