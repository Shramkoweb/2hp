---
import type { CollectionEntry } from "astro:content";
import { formatList, formatMonth, formatNumber } from "../lib/format";
import WeeklyChart from "./WeeklyChart.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { id, data } = Astro.props.project;
const kind = `${formatList(data.stores)} · since ${formatMonth(data.since)}`;
const rating = `users · ${data.rating.toFixed(1)} from ${String(data.ratings)} ratings`;
---

<article class="proj" id={`p-${id}`}>
  <div class="plate sm">
    <img
      class="logo"
      src={data.logo.src}
      alt=""
      width={data.logo.width}
      height={data.logo.height}
    />
  </div>
  <div>
    <h3>{data.name}</h3>
    <p class="kind">{kind}</p>
    <p class="what">{data.what}</p>
  </div>
  <WeeklyChart name={data.name} installs={data.installs} />
  <div class="now">
    <b>{formatNumber(data.users)}</b>
    <span>{rating}</span>
  </div>
</article>
