---
import type { CollectionEntry } from "astro:content";
import { formatList, formatMonth, formatNumber } from "../lib/format";
import Plate from "./Plate.astro";
import WeeklyChart from "./WeeklyChart.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { id, data } = Astro.props.project;
const kind = `${formatList(data.stores)} · since ${formatMonth(data.since)}`;
const rating = `users · ${data.rating.toFixed(1)} from ${String(data.ratings)} ratings`;
---

<article
  class="grid grid-cols-project-sm items-start gap-x-5 gap-y-4 border-b-2 border-foreground py-10 first-of-type:border-t-2 md:grid-cols-project-md md:items-center md:gap-x-10 md:gap-y-0 lg:grid-cols-project"
  id={`p-${id}`}
>
  <Plate size="row">
    <img
      class="block aspect-square h-auto w-31/50 object-contain"
      src={data.logo.src}
      alt=""
      width={data.logo.width}
      height={data.logo.height}
    />
  </Plate>
  <div>
    <h3 class="m-0 text-title">{data.name}</h3>
    <p class="m-0 mt-1 mb-2 text-meta text-muted-foreground">{kind}</p>
    <p class="m-0 max-w-what text-small/body text-muted-foreground">
      {data.what}
    </p>
  </div>
  <WeeklyChart
    class="col-span-full md:col-auto"
    name={data.name}
    installs={data.installs}
  />
  <div class="col-span-full flex flex-wrap items-baseline gap-x-4 gap-y-1 md:col-start-2 md:mt-4 lg:col-auto lg:mt-0 lg:flex-col lg:flex-nowrap lg:items-end lg:gap-0.5 lg:text-right">
    <b class="text-stat tabular-nums">{formatNumber(data.users)}</b>
    <span class="text-meta text-muted-foreground tabular-nums">{rating}</span>
  </div>
</article>
