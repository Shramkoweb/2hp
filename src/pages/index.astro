---
import Follow from "../components/Follow.astro";
import Hero from "../components/Hero.astro";
import Numbers from "../components/Numbers.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Sprite from "../components/Sprite.astro";
import Wins from "../components/Wins.astro";
import Writing from "../components/Writing.astro";
import bricolage from "../assets/fonts/bricolage.woff2?url";
import oi from "../assets/fonts/oi.woff2?url";
import og from "../assets/og.png";
import "../styles/global.css";

const title = "TwoHour Project by Serhii Shramko: apps and their real numbers";
const description =
  "Serhii Shramko, an indie developer in Boston, builds small apps in public and posts the real numbers: users, weekly installs and ratings.";
const url = new URL("/", Astro.site).href;
const image = new URL(og.src, Astro.site).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${url}#website`,
      name: "TwoHour Project",
      url,
      description,
      inLanguage: "en",
      publisher: { "@id": `${url}#person` },
    },
    {
      "@type": "Person",
      "@id": `${url}#person`,
      name: "Serhii Shramko",
      url,
      jobTitle: "Indie developer",
      sameAs: [
        "https://x.com/twohourproject",
        "https://t.me/twohourproject",
        "https://github.com/shramkoweb",
        "https://shramko.dev",
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TwoHour Project" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta
      property="og:image:alt"
      content="TwoHour Project. Small apps, built in public: real users, real numbers."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@twohourproject" />
    <link rel="preload" href={oi} as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href={bricolage}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <Sprite />
    <SiteHeader />
    <main id="top">
      <Hero />
      <Numbers />
      <Wins />
      <Writing />
      <Follow />
    </main>
    <SiteFooter />
    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
